    });
%}


# ============================ Rate limit ============================
# Логин и регистрация: не больше 10 запросов в минуту с одного IP.
# Чтобы увидеть 429: нажми ▶ у запроса ниже 11 раз подряд (быстрее минуты).
# Через минуту счётчик в Redis истечёт и запросы снова пройдут.
# Внимание: запросы 2, 3, 15, 16 из этого файла тоже считаются в лимит.

### 22. Логин с неверным паролем — повторяй до 429 Too Many Requests
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "me@mail.com",
  "password": "wrong-password"
}
