# =====================================================================
#  Ручная проверка API в GoLand (HTTP Client)
# =====================================================================
#  Перед запуском:
#    1. docker compose ps        — контейнеры healthy
#    2. make migrate-up          — миграции применены
#    3. make run                 — сервер запущен (ровно один!)
#
#  Как пользоваться:
#    - Нажимай зелёную ▶ слева от запроса, СТРОГО ПО ПОРЯДКУ сверху вниз:
#      следующие запросы используют token и file_id из предыдущих.
#    - Или кнопка «Run All Requests in File» вверху файла — выполнит всё подряд.
#    - Блок > {% ... %} после запроса — JS-скрипт, который выполняется после ответа:
#        client.global.set(...)  — сохраняет значение в переменную ({{имя}})
#        client.test(...)        — проверка; результат видно на вкладке Tests
# =====================================================================

# Переменная на весь файл — адрес сервера.
@host = http://localhost:8000


### 1. Health — сервер жив
GET {{host}}/health

> {%
    client.test("сервер отвечает 200", function () {
        client.assert(response.status === 200, "статус: " + response.status);
    });
%}


# ============================ Авторизация ============================

### 2. Регистрация первого пользователя (повторный запуск даст 409 — это нормально)
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "me@mail.com",
  "password": "supersecret"
}

> {%
    client.test("пользователь создан или уже есть", function () {
        client.assert(response.status === 201 || response.status === 409, "статус: " + response.status);
    });
%}

### 3. Логин — сохраняем токен в переменную token
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "me@mail.com",
  "password": "supersecret"
}

> {%
    client.test("логин успешен, токен получен", function () {
        client.assert(response.status === 200, "статус: " + response.status);
        client.assert(response.body.token, "в ответе нет token");
    });
    client.global.set("token", response.body.token);
%}

### 4. Текущий пользователь (с токеном)
GET {{host}}/api/v1/users/me
Authorization: Bearer {{token}}

> {%
    client.test("вернулся мой пользователь", function () {
        client.assert(response.status === 200, "статус: " + response.status);
        client.assert(response.body.email === "me@mail.com", "email: " + response.body.email);
    });
%}


# ======================= Загрузка и скачивание =======================

### 5. Загрузка файла с диска (README.md из проекта)
# multipart/form-data — так браузеры отправляют файлы.
# boundary — строка-разделитель между частями формы.
# "< ./README.md" — подставить содержимое файла (путь относительно этого .http-файла).
POST {{host}}/api/v1/files
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="README.md"
Content-Type: text/markdown

< ./README.md
--boundary--

> {%
    client.test("файл загружен", function () {
        client.assert(response.status === 201, "статус: " + response.status);
        client.assert(response.body.name === "README.md", "имя: " + response.body.name);
        client.assert(response.body.size > 0, "размер: " + response.body.size);
    });
    // Запоминаем id для следующих запросов.
    client.global.set("file_id", response.body.id);
%}

### 6. Загрузка файла с кириллицей в имени (содержимое прямо здесь, без файла на диске)
POST {{host}}/api/v1/files
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="отчёт.txt"
Content-Type: text/plain

Привет! Это тестовый файл с кириллицей.
--boundary--

> {%
    client.test("файл с кириллицей загружен", function () {
        client.assert(response.status === 201, "статус: " + response.status);
        client.assert(response.body.name === "отчёт.txt", "имя: " + response.body.name);
    });
    client.global.set("file_id_ru", response.body.id);
%}

### 7. Список моих файлов (новые сверху)
GET {{host}}/api/v1/files?limit=20&offset=0
Authorization: Bearer {{token}}

> {%
    client.test("в списке есть загруженные файлы", function () {
        client.assert(response.status === 200, "статус: " + response.status);
        client.assert(response.body.length >= 2, "файлов: " + response.body.length);
    });
%}

### 8. Метаданные файла
GET {{host}}/api/v1/files/{{file_id}}
Authorization: Bearer {{token}}

> {%
    client.test("метаданные получены", function () {
        client.assert(response.status === 200, "статус: " + response.status);
        client.assert(response.body.id === client.global.get("file_id"), "id не совпал");
    });
%}

### 9. Скачать README.md
# >>! — сохранить тело ответа в файл (перезаписать, если уже есть).
# После выполнения открой /tmp/downloaded-README.md и сравни с README.md.
GET {{host}}/api/v1/files/{{file_id}}/download
Authorization: Bearer {{token}}

> {%
    client.test("файл скачан с правильными заголовками", function () {
        client.assert(response.status === 200, "статус: " + response.status);
        client.assert(response.headers.valueOf("Content-Disposition").indexOf("README.md") !== -1,
            "Content-Disposition: " + response.headers.valueOf("Content-Disposition"));
        client.assert(response.body.indexOf("file-upload") !== -1, "содержимое не похоже на README");
    });
%}

>>! /tmp/downloaded-README.md

### 10. Скачать файл с кириллицей — смотри заголовок Content-Disposition в ответе
GET {{host}}/api/v1/files/{{file_id_ru}}/download
Authorization: Bearer {{token}}

> {%
    client.test("содержимое совпадает", function () {
        client.assert(response.status === 200, "статус: " + response.status);
        client.assert(response.body.indexOf("Привет!") !== -1, "тело: " + response.body);
    });
%}


# ======================= Публичная ссылка =======================
# Ссылка на скачивание без авторизации: {{host}}/s/<id файла>.
# Её можно открыть прямо в браузере — файл скачается без токена.

### 10a. Скачать README.md по публичной ссылке БЕЗ токена
GET {{host}}/s/{{file_id}}

> {%
    client.test("файл скачан по ссылке без авторизации", function () {
        client.assert(response.status === 200, "статус: " + response.status);
        client.assert(response.body.indexOf("file-upload") !== -1, "содержимое не похоже на README");
    });
%}

### 10b. Публичная ссылка на несуществующий файл → 404
GET {{host}}/s/00000000-0000-0000-0000-000000000000

> {%
    client.test("404 на несуществующий файл", function () {
        client.assert(response.status === 404, "статус: " + response.status);
    });
%}


