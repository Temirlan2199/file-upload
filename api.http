%}


# ===================== Чужие файлы недоступны ========================

### 15. Регистрация второго пользователя
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "other@mail.com",
  "password": "supersecret"
}

### 16. Логин второго пользователя → token2
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "other@mail.com",
  "password": "supersecret"
}

> {%
    client.global.set("token2", response.body.token);
%}

### 17. Второй пользователь пытается скачать файл первого → 404
GET {{host}}/api/v1/files/{{file_id}}/download
Authorization: Bearer {{token2}}

> {%
    client.test("чужой файл не виден", function () {
        client.assert(response.status === 404, "статус: " + response.status);
    });
%}

### 18. Второй пользователь пытается удалить файл первого → 404
DELETE {{host}}/api/v1/files/{{file_id}}
Authorization: Bearer {{token2}}

> {%
    client.test("чужой файл не удалить", function () {
        client.assert(response.status === 404, "статус: " + response.status);
    });
%}


