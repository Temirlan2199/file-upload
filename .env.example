# Скопируй в .env: cp .env.example .env
# .env в .gitignore — реальные секреты в git не попадают.

# --- Приложение ---
APP_ENV=local
HTTP_PORT=8000
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=file_upload
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Kafka ---
KAFKA_EXTERNAL_PORT=9094

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
