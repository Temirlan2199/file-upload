# Скопируй в .env: cp .env.example .env
# .env в .gitignore — реальные секреты в git не попадают.

# --- Приложение ---
APP_ENV=local
HTTP_PORT=8000
# Внешний адрес сервиса — из него строятся ссылки «поделиться»
PUBLIC_URL=http://localhost:8000

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=file_upload
POSTGRES_PORT=5432
# Строка подключения для приложения и миграций
POSTGRES_DSN=postgres://app:app@localhost:5432/file_upload?sslmode=disable

# --- JWT ---
# В проде — длинная случайная строка: openssl rand -base64 32
JWT_SECRET=local-dev-secret-change-me
JWT_TTL=15m

# --- Redis ---
REDIS_PORT=6379
# Адрес Redis для приложения
REDIS_ADDR=localhost:6379

# --- Kafka ---
KAFKA_EXTERNAL_PORT=9094

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000

# Подключение приложения к MinIO (локально — те же логин/пароль, что у root)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=files
MINIO_USE_SSL=false
