# Скопируй в .env: cp .env.example .env
# .env в .gitignore — реальные секреты в git не попадают.

# --- Приложение ---
APP_ENV=local
HTTP_PORT=8000
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=file_upload
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10

# --- JWT ---
# В проде — длинная случайная строка: openssl rand -base64 32
JWT_SECRET=local-dev-secret-change-me
JWT_ACCESS_TTL=15m

# --- Redis ---
REDIS_PORT=6379

# --- Kafka ---
KAFKA_EXTERNAL_PORT=9094

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
